# ==============================================================================
# PROJECT HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development or configure in Vercel / Cloud Functions.
# NEVER commit the actual '.env' or any production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT ENVIRONMENT VARIABLES (Vite - prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Project Hub"
VITE_APP_URL="http://localhost:5173"

# Firebase Client Configuration (From Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="AIzaSyExampleKeyForLocalDevelopmentOnly"
VITE_FIREBASE_AUTH_DOMAIN="project-hub-demo.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="project-hub-demo"
VITE_FIREBASE_STORAGE_BUCKET="project-hub-demo.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
VITE_FIREBASE_MEASUREMENT_ID="G-ABCDEF1234"
VITE_ENABLE_FIREBASE_STORAGE="false"

# Firebase App Check (Optional in local development; required in production)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""
VITE_RECAPTCHA_ENTERPRISE_KEY=""

# Firebase Emulators (Set to "true" to point to local Firebase Emulators)
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
VITE_FIRESTORE_EMULATOR_HOST="localhost:8080"
VITE_FUNCTIONS_EMULATOR_HOST="localhost:5001"

# Cloudinary Public Configuration (Client only needs Cloud Name and API Key)
VITE_CLOUDINARY_CLOUD_NAME="demo-company"
VITE_CLOUDINARY_API_KEY="123456789012345"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE CLOUD FUNCTIONS ENVIRONMENT VARIABLES (functions/.env)
# ------------------------------------------------------------------------------
# Cloudinary Private Secret (NEVER expose to Vite or frontend code)
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"
CLOUDINARY_CLOUD_NAME="demo-company"
CLOUDINARY_API_KEY="123456789012345"

# Platform Governance
COMPANY_ALLOWED_DOMAIN="company.com"
ADMIN_INVITE_SECRET="super-secure-random-secret-token"
ARENA_MIN_VOTE_THRESHOLD=10
TRENDING_WINDOW_DAYS=7

